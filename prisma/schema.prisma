generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER // full access
  ADMIN // manage products, leads, prospects, blogs, customer
  SALES // manage leads, prospects
  CUSTOMER // view product, submit leads, view blog (in landing page)
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerProfile CustomerProfile?

  prospects Prospect[]

  assignedSalesId   String?
  assignedSales     User?   @relation("CustomerSalesAssignment", fields: [assignedSalesId], references: [id])
  assignedCustomers User[]  @relation("CustomerSalesAssignment")

  submittedLeads Lead[] @relation("CustomerLeads")
  managedLeads   Lead[] @relation("SalesLeads")

  salesProfile SalesProfile?
}

model CustomerProfile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName  String
  phone        String
  industry     String?
  address      String? @db.Text
  companyEmail String?
  website      String?
  jobTitle     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalesProfile {
  id           String @id @default(uuid())
  userId       String @unique
  referralCode String @unique

  user User @relation(fields: [userId], references: [id])
}

model Product {
  id       String @id @default(cuid())
  name     String
  slug     String @unique
  category String

  description String? @db.Text
  thickness   String?
  sizeRange   String?
  moq         Int     @default(1000)
  uom         String?
  imageUrl    String?

  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Prospect {
  id              String  @id @default(uuid())
  companyName     String
  picName         String
  picTitle        String? // Jabatan
  phone           String
  industry        String? // Industri
  potentialVolume Int? // Potensi Volume Order (Ton/Bulan)
  checklistJson   Json?

  salesId String
  sales   User   @relation(fields: [salesId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Lead {
  id      String  @id @default(uuid())
  name    String
  phone   String
  email   String?
  company String

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  estimatedQty   String?
  customPrinting Boolean?
  notes          String?  @db.Text
  status         String   @default("NEW")

  customerId String?
  customer   User?   @relation("CustomerLeads", fields: [customerId], references: [id])

  salesId String?
  sales   User?   @relation("SalesLeads", fields: [salesId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebsiteSetting {
  id              String   @id @default(uuid())
  companyName     String   @default("Velora Pack")
  address         String   @db.Text
  mapsEmbedUrl    String?  @db.Text
  email           String
  mainWhatsApp    String
  capacityMetrics Json? // Contoh format: { lines: 10, tonPerMonth: 100 }
  updatedAt       DateTime @updatedAt
}

model Blog {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  excerpt         String?   @db.Text
  metaDescription String    @db.Text
  content         String    @db.Text
  coverImage      String?
  author          String?   @default("Velora Pack")
  readingTime     Int?
  tags            String[]
  published       Boolean   @default(false)
  publishedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
