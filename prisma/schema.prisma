generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  company   String
  notes     String?  @db.Text
  status    String   @default("Open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}